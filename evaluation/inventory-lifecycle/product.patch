+    let appended = format!("{raw}\n{next_raw}\n");
+    fs::write(&month, &appended).unwrap();
+    assert!(pack::apply(&repo, &preview).is_err());
+    assert_eq!(fs::read_to_string(month).unwrap(), appended);
+}
