{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:belay:omnia:confirmed-input:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "contract_id",
    "revision",
    "issued_at",
    "compiler_version",
    "outcome",
    "requirements",
    "acceptance_criteria",
    "constraints",
    "non_goals",
    "unknowns",
    "delegation",
    "verification",
    "stop_conditions",
    "target",
    "source_bundle",
    "input_id",
    "input_revision",
    "confirmation_ref",
    "assumptions",
    "context_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "enum": [
        "confirmed",
        "draft"
      ]
    },
    "contract_id": {
      "type": "string",
      "pattern": "[A-Z][A-Z0-9-]{2,63}"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "compiler_version": {
      "const": "omnia-contract-compiler/1"
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourced_item"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourced_item"
      }
    },
    "constraints": {
      "$ref": "#/$defs/nonempty_strings"
    },
    "non_goals": {
      "$ref": "#/$defs/nonempty_strings"
    },
    "unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delegation": {
      "$ref": "#/$defs/delegation"
    },
    "verification": {
      "$ref": "#/$defs/nonempty_strings"
    },
    "stop_conditions": {
      "$ref": "#/$defs/nonempty_strings"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "source_bundle": {
      "$ref": "#/$defs/source_bundle"
    },
    "input_id": {
      "type": "string",
      "minLength": 1
    },
    "input_revision": {
      "type": "integer",
      "minimum": 1
    },
    "confirmation_ref": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourced_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "[A-Z]+-[0-9]{3}"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "scope",
        "allowed_operations"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "allowed_operations": {
          "$ref": "#/$defs/nonempty_strings"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        }
      }
    },
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_digest",
        "sources"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "sha256:[0-9a-f]{64}"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url",
              "retrieved_at",
              "raw_snapshot_ref",
              "raw_sha256",
              "normalized_sha256",
              "complete"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "raw_snapshot_ref": {
                "type": "string",
                "minLength": 1
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "sha256:[0-9a-f]{64}"
              },
              "normalized_sha256": {
                "type": "string",
                "pattern": "sha256:[0-9a-f]{64}"
              },
              "complete": {
                "type": "boolean"
              },
              "edited_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "acquisition_digest": {
          "type": "string",
          "pattern": "sha256:[0-9a-f]{64}"
        }
      }
    }
  }
}
