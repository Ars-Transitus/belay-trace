{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:belay:omnia:contract:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "revision",
    "issued_at",
    "compiler_version",
    "outcome",
    "requirements",
    "acceptance_criteria",
    "constraints",
    "non_goals",
    "unknowns",
    "delegation",
    "verification",
    "stop_conditions",
    "target",
    "source_bundle",
    "lifecycle",
    "contract_digest",
    "input_id",
    "input_revision",
    "confirmation_ref",
    "assumptions",
    "context_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "contract_id": {
      "type": "string",
      "pattern": "[A-Z][A-Z0-9-]{2,63}"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "compiler_version": {
      "const": "omnia-contract-compiler/1"
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "confirmed-input.schema.json#/$defs/sourced_item"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "confirmed-input.schema.json#/$defs/sourced_item"
      }
    },
    "constraints": {
      "$ref": "confirmed-input.schema.json#/$defs/nonempty_strings"
    },
    "non_goals": {
      "$ref": "confirmed-input.schema.json#/$defs/nonempty_strings"
    },
    "unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delegation": {
      "$ref": "confirmed-input.schema.json#/$defs/delegation"
    },
    "verification": {
      "$ref": "confirmed-input.schema.json#/$defs/nonempty_strings"
    },
    "stop_conditions": {
      "$ref": "confirmed-input.schema.json#/$defs/nonempty_strings"
    },
    "target": {
      "$ref": "confirmed-input.schema.json#/$defs/target"
    },
    "source_bundle": {
      "$ref": "confirmed-input.schema.json#/$defs/source_bundle"
    },
    "lifecycle": {
      "enum": [
        "active",
        "cancelled",
        "expired",
        "superseded"
      ]
    },
    "contract_digest": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "input_id": {
      "type": "string",
      "minLength": 1
    },
    "input_revision": {
      "type": "integer",
      "minimum": 1
    },
    "confirmation_ref": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
