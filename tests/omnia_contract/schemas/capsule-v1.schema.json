{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:belay:omnia:capsule:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_revision", "contract_digest", "evaluated_as_of", "execution", "verification", "human_acceptance", "lifecycle", "source_freshness", "criteria"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1}, "contract_id": {"type": "string", "pattern": "[A-Z][A-Z0-9-]{2,63}"}, "contract_revision": {"type": "integer", "minimum": 1}, "contract_digest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"},
    "evaluated_as_of": {"type": "string", "format": "date-time"}, "execution": {"enum": ["not-started", "running", "paused", "completed", "cancelled"]},
    "verification": {"enum": ["unverified", "partial", "verified", "failed"]}, "human_acceptance": {"enum": ["pending", "accepted", "rejected"]},
    "lifecycle": {"enum": ["active", "cancelled", "expired", "superseded"]}, "source_freshness": {"enum": ["observed-current", "changed", "unknown"]},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "verification", "evidence"], "properties": {"id": {"type": "string", "pattern": "AC-[0-9]{3}"}, "verification": {"enum": ["unverified", "partial", "verified", "failed"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_binding"}}}}},
    "human_acceptance_binding": {"type": "object", "description": "Structural binding only; schema validity does not authenticate the issuer or establish authority.", "additionalProperties": false, "required": ["contract_id", "contract_revision", "contract_digest", "operation", "issuer", "evidence"], "properties": {"contract_id": {"type": "string", "pattern": "[A-Z][A-Z0-9-]{2,63}"}, "contract_revision": {"type": "integer", "minimum": 1}, "contract_digest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}, "operation": {"enum": ["accept", "reject"]}, "issuer": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_binding"}}}}
  },
  "$defs": {
    "evidence_binding": {"type": "object", "additionalProperties": false, "required": ["id", "artifact_sha256", "state"], "properties": {"id": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}, "state": {"enum": ["passing", "missing", "stale", "failed"]}}}
  }
}
